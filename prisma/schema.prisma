generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  name            String
  email           String
  studyGoal       String   @default("ENEM") @map("study_goal")
  targetDate      DateTime? @map("target_date")
  dailyMinutes    Int      @default(60) @map("daily_minutes")
  level           String   @default("beginner")
  studyMethod     String   @default("pomodoro") @map("study_method")
  onboardingDone  Boolean  @default(false) @map("onboarding_done")
  /// Respostas detalhadas do onboarding (motivo, prova, série, idioma, dificuldades, preferências).
  personalization Json?
  /// Quando o aluno terminou (ou pulou) o tutorial guiado do app.
  tourCompletedAt DateTime? @map("tour_completed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  studyPlans     StudyPlan[]
  uploadedFiles  UploadedFile[]
  quizzes        Quiz[]
  flashcardDecks FlashcardDeck[]
  essays         Essay[]
  chatMessages   ChatMessage[]
  studySessions  StudySession[]
  subscription   Subscription?

  @@map("profiles")
}

model StudyPlan {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String
  goal         String
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  dailyMinutes Int      @map("daily_minutes")
  status       String   @default("active")
  planData     Json     @map("plan_data")
  createdAt    DateTime @default(now()) @map("created_at")

  profile  Profile @relation(fields: [userId], references: [userId])
  subjects StudyPlanSubject[]

  @@map("study_plans")
}

model StudyPlanSubject {
  id          String @id @default(uuid())
  planId      String @map("plan_id")
  name        String
  priority    String @default("medium")
  weeklyHours Int    @map("weekly_hours")
  color       String @default("#1B4FD8")
  difficulty  Int    @default(3)

  plan StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("study_plan_subjects")
}

model StudySession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  subject         String
  durationMinutes Int      @map("duration_minutes")
  date            DateTime @default(now())
  method          String   @default("free")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@map("study_sessions")
}

model UploadedFile {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  type        String
  sizeBytes   Int      @map("size_bytes")
  storagePath String   @map("storage_path")
  processed   Boolean  @default(false)
  textContent String?  @map("text_content") @db.Text
  /// Link de origem (vídeo do YouTube); vazio para arquivos enviados.
  sourceUrl   String?  @map("source_url")
  /// Motivo da última falha de processamento, mostrado ao aluno.
  processingError String? @map("processing_error")
  createdAt   DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])
  quizzes Quiz[]

  @@index([sourceUrl])
  @@map("uploaded_files")
}

model Quiz {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fileId        String?  @map("file_id")
  title         String
  subject       String
  difficulty    String   @default("medium")
  questionCount Int      @map("question_count")
  score         Float?
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  profile   Profile      @relation(fields: [userId], references: [userId])
  file      UploadedFile? @relation(fields: [fileId], references: [id])
  questions QuizQuestion[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String  @map("quiz_id")
  question      String  @db.Text
  options       Json
  correctAnswer String  @map("correct_answer")
  explanation   String  @db.Text
  userAnswer    String? @map("user_answer")
  isCorrect     Boolean? @map("is_correct")
  order         Int     @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model FlashcardDeck {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  subject   String
  createdAt DateTime @default(now()) @map("created_at")

  profile    Profile     @relation(fields: [userId], references: [userId])
  flashcards Flashcard[]

  @@map("flashcard_decks")
}

model Flashcard {
  id          String    @id @default(uuid())
  deckId      String    @map("deck_id")
  front       String    @db.Text
  back        String    @db.Text
  easeFactor  Float     @default(2.5) @map("ease_factor")
  interval    Int       @default(1)
  repetitions Int       @default(0)
  nextReview  DateTime  @default(now()) @map("next_review")
  createdAt   DateTime  @default(now()) @map("created_at")

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model Essay {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  content   String   @db.Text
  model     String   @default("ENEM")
  score     Float?
  feedback  Json?
  theme     String?
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@map("essays")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      String
  content   String   @db.Text
  fileId    String?  @map("file_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@map("chat_messages")
}

/// Um uso de um recurso com limite (mensagem do chat, redação, upload...). O limite do plano é contado aqui.
model UsageEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  feature   String
  /// Peso no teto global de segurança do dia (ver FEATURES em src/lib/plans.ts).
  units     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, feature, createdAt])
  @@index([userId, createdAt])
  @@map("usage_events")
}

/// Uma chamada à IA com tokens e custo estimado. Responde "quanto custa o aluno que mais usa o plano X?".
model AiCallLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  /// Plano do aluno no momento da chamada (free, basic, full) ou null fora de uma requisição de aluno.
  plan         String?
  /// Recurso que originou a chamada (chat_message, ai_quiz, batch_questions...).
  feature      String?
  model        String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_call_logs")
}

/// Assinatura Stripe do aluno. Só o servidor grava (webhook e retorno do checkout); o aluno só lê.
model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique @map("user_id")
  stripeCustomerId     String    @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  plan                 String?
  status               String    @default("none")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  firstPaidAt          DateTime? @map("first_paid_at")
  refundedAt           DateTime? @map("refunded_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@map("subscriptions")
}

/// Eventos do webhook já processados (o Stripe pode reenviar o mesmo evento).
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}
