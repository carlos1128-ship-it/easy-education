{
  "$description": "Easy Education — tokens do design system. Fonte da verdade no código: src/app/globals.css.",
  "color": {
    "light": {
      "bg": "#f6f8fc",
      "surface": "#ffffff",
      "surface-muted": "#eef2f9",
      "border": "#e2e8f0",
      "border-strong": "#64748b",
      "ink": "#0f172a",
      "ink-muted": "#475569",
      "brand": "#2563eb",
      "brand-strong": "#1d4ed8",
      "brand-deep": "#1e3a8a",
      "brand-soft": "#bfdbfe",
      "brand-tint": "#dbeafe",
      "on-brand": "#ffffff",
      "accent": "#06b6d4",
      "focus-ring": "#1d4ed8",
      "success": "#166534",
      "success-tint": "#dcfce7",
      "warning": "#92400e",
      "warning-tint": "#fef3c7",
      "danger": "#b91c1c",
      "danger-tint": "#fee2e2"
    },
    "dark": {
      "bg": "#070a13",
      "surface": "#0d1117",
      "surface-muted": "#121a2b",
      "border": "#1a2744",
      "border-strong": "#5b6b8c",
      "ink": "#f1f5f9",
      "ink-muted": "#94a3b8",
      "brand": "#60a5fa",
      "brand-strong": "#93c5fd",
      "brand-deep": "#1e40af",
      "brand-soft": "#1e3a6e",
      "brand-tint": "#0f1e3d",
      "on-brand": "#06142e",
      "accent": "#22d3ee",
      "focus-ring": "#93c5fd",
      "success": "#4ade80",
      "success-tint": "#0f2a1b",
      "warning": "#fbbf24",
      "warning-tint": "#33260a",
      "danger": "#f87171",
      "danger-tint": "#3a1416"
    }
  },
  "typography": {
    "family": {
      "sans": "Lexend, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "display": "Lexend, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "JetBrains Mono, ui-monospace, Menlo, Consolas, monospace"
    },
    "source": "next/font/google, fonte variável (wght 100–900), subsets latin e latin-ext, display swap",
    "cssVariables": {
      "sans": "--font-sans",
      "display": "--font-display",
      "mono": "--font-mono"
    },
    "weight": {
      "extralight": { "value": 200, "tailwind": "font-extralight", "minSize": "32px" },
      "light": { "value": 300, "tailwind": "font-light", "minSize": "18px" },
      "regular": { "value": 400, "tailwind": "font-normal" },
      "medium": { "value": 500, "tailwind": "font-medium" },
      "semibold": { "value": 600, "tailwind": "font-semibold" },
      "bold": { "value": 700, "tailwind": "font-bold" },
      "extrabold": { "value": 800, "tailwind": "font-extrabold" },
      "black": { "value": 900, "tailwind": "font-black" }
    },
    "roles": {
      "hero-title": { "weight": "black", "color": ["ink", "brand"], "note": "palavra-chave em brand" },
      "mixed-title": { "weight": ["light", "black"], "color": ["ink", "brand"] },
      "section-title": { "weight": ["bold", "extrabold"], "color": ["ink", "brand-deep"] },
      "lead-large": { "weight": "light", "color": "ink-muted", "minSize": "18px" },
      "metric": { "weight": ["black", "extrabold"], "color": "brand", "note": "dashboard e telas de estudo: até extrabold" },
      "body": { "weight": "regular", "color": "ink" },
      "label": { "weight": ["medium", "semibold"], "color": ["ink", "on-brand"], "note": "botões, abas, menu" },
      "caption": { "weight": "medium", "color": "ink-muted", "note": "legendas, metadados, selos" },
      "footer": { "weight": "regular", "color": "ink-muted" },
      "brand-band-title": { "weight": "black", "color": "on-brand" },
      "brand-band-lead": { "weight": "light", "color": "on-brand" }
    }
  }
}
