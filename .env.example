NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon
# Opcional: pode substituir a anon key acima se seu projeto usar publishable keys novas.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
GEMINI_API_KEY=sua_chave_gemini
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres
NEXT_PUBLIC_APP_URL=http://localhost:3000


# Stripe (pagamentos). Sem STRIPE_SECRET_KEY a cobranca fica desligada.
STRIPE_SECRET_KEY=sk_test_sua_chave
STRIPE_WEBHOOK_SECRET=whsec_seu_segredo
# Opcional: e-mails liberados sem assinatura, separados por virgula.
BILLING_EXEMPT_EMAILS=
# Opcional (so desenvolvimento): BILLING_REQUIRED=false deixa todo mundo no plano Completo, sem limites de plano.
# Os limites de cada plano (Gratuito, Basico, Completo) ficam em src/lib/plans.ts, nao em variaveis de ambiente.
# Telas internas (custo de IA, reports e revisao de questoes). Sem esta variavel, vale BILLING_EXEMPT_EMAILS.
# ADMIN_EMAILS=voce@exemplo.com
# Cambio usado so para mostrar reais na tela de custos (padrao 5.5).
# USD_BRL=5.5
# Contato de suporte mostrado ao reportar uma questao (use um dos dois; sem eles o link nao aparece).
# NEXT_PUBLIC_SUPPORT_EMAIL=suporte@exemplo.com
# NEXT_PUBLIC_SUPPORT_URL=https://wa.me/55...
# O e-mail de suporte tambem aparece no rodape, nos Termos e na Privacidade. Responsavel pelos dados (LGPD):
# NEXT_PUBLIC_LEGAL_ENTITY=Razao Social Ltda, CNPJ 00.000.000/0001-00
# Conferencia das questoes com outro modelo (vazio = o mesmo da geracao). Ver docs/confiabilidade-ia.md.
# GEMINI_VERIFY_MODEL=gemini-2.5-flash
# Modelo do plano B do portao de qualidade (materia abaixo de 90% na ultima avaliacao).
# GEMINI_STRONG_MODEL=gemini-2.5-flash
# Modelos rapidos para quiz/simulado/flashcards (em ordem de preferencia).
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
